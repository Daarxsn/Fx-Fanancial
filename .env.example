# Safe placeholders only. Put real credentials in the ignored .env.local file.
DATABASE_HOST=your-mysql-host
DATABASE_PORT=3306
DATABASE_NAME=defaultdb
DATABASE_USER=your-database-user
DATABASE_PASSWORD=replace-locally
DATABASE_SSL=true

# Generate a unique random value of at least 32 characters per environment.
# This placeholder is not a usable production secret.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
